          MARIADB_URL:
            source: template
            value: mariadb://{{.MARIADB_USERNAME}}:{{.MARIADB_PASSWORD | urlquery }}@{{.MARIADB_HOST}}:{{.MARIADB_PORT}}
          MARIADB_USERNAME:
            source: const
            value: root
          ca.crt:
            key: ca.crt
            kind: Secret
            name: instance-vshnmariadb-ca
            source: objectRef
      target:
        name: instance-credentials
  8: |
    apiVersion: monitoring.coreos.com/v1
    kind: PrometheusRule
    metadata:
      labels:
        app.kubernetes.io/instance: instance
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: mariadb
        helm.sh/chart: mariadb-0.0.4
      name: mariadb
      namespace: instance-ns
    spec:
      groups:
        - name: mariadb-rules
          rules:
            - alert: MySQLGaleraPvcFull
              annotations:
                message: The Galera cluster {{$labels.instance}} is out of disk space.
                runbook_url: https://kb.vshn.ch/app-catalog/csp/spks/runbooks/mariadb_galera/MySQLGaleraNotReady.html
              expr: |
                (kubelet_volume_stats_available_bytes{job="kubelet",metrics_path="/metrics"} / kubelet_volume_stats_capacity_bytes{job="kubelet",metrics_path="/metrics"}) < 0.01 and kubelet_volume_stats_used_bytes{job="kubelet",metrics_path="/metrics"} > 0
              for: 5m
              labels:
                service: storage
                severity: warning
            - alert: MySQLGaleraClusterDown
              annotations:
                message: Galera cluster {{$labels.instance}} is down.
                runbook_url: https://kb.vshn.ch/app-catalog/csp/spks/runbooks/mariadb_galera/MySQLGaleraClusterDown.html
              expr: |
                (
                  sum by(namespace) (mysql_up{service="mariadb-metrics"}) < 1
                  or
                  sum by(namespace) (kube_statefulset_status_replicas_ready{statefulset="mariadb"}) < 1
                )
                and on(namespace)
                kube_statefulset_replicas{statefulset="mariadb"} > 0
              for: 5m
              labels:
                service: backend-core
                severity: critical
            - alert: MySQLInnoDBLogWaits
              annotations:
                message: The innodb logs of node ({{$labels.pod}}) in namespace {{$labels.namespace}} are waiting for disk at a rate of {{$value}} / second
                runbook_url: https://kb.vshn.ch/app-catalog/csp/spks/runbooks/mariadb_galera/MySQLInnoDBLogWaits.html
              expr: |
                rate(mysql_global_status_innodb_log_waits[15m]) > 10
              labels:
                service: backend
                severity: info
            - alert: MySQLGaleraClusterEvenNodes
              annotations:
                message: Galera Cluster in namespace {{$labels.namespace}} had an even number of nodes during the last 30m
                runbook_url: https://kb.vshn.ch/app-catalog/csp/spks/runbooks/mariadb_galera/MySQLGaleraClusterEvenNodes.html
              expr: |
                avg by(namespace) (mysql_global_status_wsrep_cluster_size) % 2 != 1
              for: 30m
              labels:
                service: backend
                severity: warning
            - alert: HAProxyBackendsDown
              annotations:
                message: HAProxy instances in namespace {{$labels.namespace}} are missing some backends
              expr: |
                avg without(instance,pod,server) (haproxy_server_status{proxy="galera-nodes", state="UP"}) != 1
                AND group without(instance,pod,server) (haproxy_server_status{proxy="galera-nodes", state="UP"} offset 20m)
              for: 5m
              labels:
                service: frontend
                severity: warning
  9: |
    apiVersion: adept.helmetica.io/v1
    kind: Definition
    metadata:
      labels:
        app.kubernetes.io/instance: instance
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: mariadb
        helm.sh/chart: mariadb-0.0.4
      name: restart
    spec:
      description: Restart the application
      jobTemplate:
        spec:
          template:
            spec:
              containers:
                - args:
                    - rollout
                    - restart
                    - statefulset/instance
                  command:
                    - kubectl
                  image: registry.k8s.io/kubectl:v1.34.1
                  name: restart
              restartPolicy: Never
renders without backups:
  1: |
    apiVersion: k8s.mariadb.com/v1alpha1
    kind: MariaDB
    metadata:
      labels:
        app.kubernetes.io/instance: instance
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: vshnmariadb
        helm.sh/chart: vshnmariadb-0.0.16
      name: instance-vshnmariadb
    spec:
      galera:
        agent:
          basicAuth:
            enabled: true
            passwordSecretKeyRef:
              generate: true
              key: password
              name: galera-basic-auth
          kubernetesAuth:
            enabled: false
        config:
          reuseStorageVolume: true
        enabled: false
        providerOptions:
          cert.log_conflicts: "yes"
          gcs.fc_single_primary: "yes"
        recovery:
          clusterBootstrapTimeout: 30m
          podSyncTimeout: 30m
      image: mariadb:11.8.8
      metrics:
        enabled: true
        exporter:
          image: nil
      myCnf: ""
      replicas: 1
      rootPasswordSecretKeyRef:
        generate: true
        key: root
        name: mariadb-cluster-root
      startupProbe:
        failureThreshold: 120
      storage:
        size: 1Gi
      tls:
        enabled: true
        required: false
      updateStrategy:
        autoUpdateDataPlane: false
  2: |
    apiVersion: sigillum.helmetica.io/v1
    kind: NetworkConfig
    metadata:
      labels:
        app.kubernetes.io/instance: instance
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: mariadb
        helm.sh/chart: mariadb-0.0.4
      name: networkconfig
    spec:
      allowAllNamespaces: false
      allowedNamespaces: []
  3: |
    apiVersion: monitoring.coreos.com/v1alpha1
    kind: AlertmanagerConfig
    metadata:
      labels:
        app.kubernetes.io/instance: instance
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: mariadb
        helm.sh/chart: mariadb-0.0.4
      name: email-alerting
    spec:
      receivers:
        - name: "null"
        - name: service_operator
        - name: service_user
        - name: service_maintainer
      route:
        groupBy:
          - alertname
          - audience
        groupInterval: 5s
        groupWait: 0s
        receiver: "null"
        repeatInterval: 4h
        routes:
          - matchers:
              - matchType: =
                name: audience
                value: service_operator
            receiver: service_operator
          - matchers:
              - matchType: =
                name: audience
                value: service_user
            receiver: service_user
          - matchers:
              - matchType: =
                name: audience
                value: service_maintainer
            receiver: service_maintainer
  4: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      labels:
        app.kubernetes.io/instance: instance
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: mariadb
        helm.sh/chart: mariadb-0.0.4
      name: allow-monitoring
    spec:
      ingress:
        - from:
            - namespaceSelector:
                matchLabels:
                  helmetica.io/monitoring: system
      podSelector: {}
      policyTypes:
        - Ingress
  5: |
    apiVersion: custos.helmetica.io/v1
    kind: CredentialConfig
    metadata:
      labels:
        app.kubernetes.io/instance: instance
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: mariadb
        helm.sh/chart: mariadb-0.0.4
      name: credentials
    spec:
      credentials:
        valueMapping:
          MARIADB_HOST:
            source: template
            value: instance-vshnmariadb.{{.InstanceNamespace}}.svc.cluster.local
          MARIADB_PASSWORD:
            key: root
            kind: Secret
            name: mariadb-cluster-root
            source: objectRef
          MARIADB_PORT:
            source: const
            value: "3306"
          MARIADB_URL:
            source: template
            value: mariadb://{{.MARIADB_USERNAME}}:{{.MARIADB_PASSWORD | urlquery }}@{{.MARIADB_HOST}}:{{.MARIADB_PORT}}
          MARIADB_USERNAME:
            source: const
            value: root
          ca.crt:
            key: ca.crt
            kind: Secret
            name: instance-vshnmariadb-ca
            source: objectRef
      target:
        name: instance-credentials
